{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/results",
      "destination": "/results.html"
    },
    {
      "source": "/calculator",
      "destination": "/calculator.html"
    },
    {
      "source": "/faqs",
      "destination": "/faqs.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/:slug([a-z0-9-]+)",
      "destination": "/:slug.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "git log -1 --pretty=%B | grep -q '\\[skip ci\\]'"
}
